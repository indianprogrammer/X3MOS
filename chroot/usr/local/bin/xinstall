#!/bin/sh
# xinstall - install menu for the installed X3M-OS system.
#
#   xinstall
#
# Options:
#   1) NetworkManager / nmcli  (ensure installed/enabled, show device status)
#   2) Docker Engine on Debian (https://docs.docker.com/engine/install/debian/)
#   3) Ookla Speedtest Server  (https://srijit.com/ookla-speedtest-server-installation-guide/)
#   4) ISP CGNAT               (reference: cgnat.md - nftables NAT44 + NATLOG)
#   5) BGP Router (FRRouting)  (frr + frr-pythontools, opens vtysh)
#
# Invoked by the normal (x3m) user. The menu re-executes itself under sudo
# because every option performs a system-wide installation (nmcli manages the
# NetworkManager service and needs root as well).

LIB=/usr/local/lib/xinstall
[ -r "$LIB/lib.sh" ] && . "$LIB/lib.sh" || exit 1

require_root

BOLD=$([ -t 1 ] && tput bold 2>/dev/null || true)
NORM=$([ -t 1 ] && tput sgr0 2>/dev/null || true)

nmcli_status() {
    if command -v nmcli >/dev/null 2>&1 && systemctl is-active NetworkManager >/dev/null 2>&1; then
        printf 'installed'
    else
        printf 'not installed'
    fi
}

docker_status() {
    if command -v docker >/dev/null 2>&1; then
        printf 'installed'
    else
        printf 'not installed'
    fi
}

speedtest_status() {
    if [ -x /opt/ooklaserver/OoklaServer ]; then
        printf 'installed'
    else
        printf 'not installed'
    fi
}

cgnat_status() {
    if command -v nft >/dev/null 2>&1 && nft list tables ip 2>/dev/null | grep -q cgnat; then
        printf 'installed'
    else
        printf 'not installed'
    fi
}

bgp_status() {
    if command -v vtysh >/dev/null 2>&1 \
        && [ -f /etc/frr/daemons ] && grep -q '^bgpd=yes' /etc/frr/daemons; then
        printf 'installed'
    else
        printf 'not installed'
    fi
}

while :; do
    clear
    printf '\n'
    printf '%s\n' \
        "${BOLD}========================================================${NORM}" \
        "${BOLD}              X3M-OS install menu${NORM}" \
        "${BOLD}========================================================${NORM}" \
        '' \
        "  [1] Install NetworkManager (nmcli,nmtui)  (status: $(nmcli_status))" \
        "      nmcli commands for managing wifi/ethernet connections." \
        '' \
        "  [2] Install Docker Engine          (status: $(docker_status))" \
        '' \
        "  [3] Install Ookla Speedtest Server (status: $(speedtest_status))" \
        "      Guide: https://srijit.com/ookla-speedtest-server-installation-guide/" \
        '' \
        "  [4] Install ISP CGNAT              (status: $(cgnat_status))" \
        '' \
        "  [5] Install BGP Router (FRR)     (status: $(bgp_status))" \
        '' \
        '  [6] Quit' \
        ''

    printf 'Choose an option [1-6]: '
    read -r choice
    case "$choice" in
        1) "$LIB/install-nmcli.sh";;
        2) "$LIB/install-docker.sh";;
        3) "$LIB/install-speedtest.sh";;
        4) "$LIB/install-cgnat.sh";;
        5) "$LIB/install-bgp.sh";;
        6) exit 0;;
        *) continue;;
    esac
    printf '\nPress ENTER to return to the menu...'
    read -r _ 2>/dev/null || true
done