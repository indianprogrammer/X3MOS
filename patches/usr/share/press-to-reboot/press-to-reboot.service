[Unit]
Description=Press ENTER to reboot (first boot)
Wants=systemd-vconsole-setup.service
After=systemd-vconsole-setup.service systemd-journald.service
Before=getty.target
ConditionPathExists=!/var/lib/press-to-reboot.done

[Service]
Type=oneshot
StandardInput=tty
StandardOutput=tty
StandardError=tty
ExecStart=/usr/local/sbin/press-to-reboot
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target