#!/bin/sh
# Runs once on the FIRST boot of the installed system, before the OS is
# fully brought up (invoked by press-to-reboot.service, ordered before
# sysinit.target). Shows a banner on the console, waits for ENTER, then
# reboots into the freshly installed system. VGA and serial consoles work.
#
# This is deterministic where an in-installer wait is not: at this point no
# other process (installer frontend, getty, etc.) owns the console, so the
# kernel delivers the keypress straight to this read.

set -u

# Already done on a previous boot? Never show again.
[ -e /var/lib/press-to-reboot.done ] && exit 0

# /dev/console tracks the kernel console: tty0 for VGA, ttyS0 when booted
# with console=ttyS0. Fall back to explicit devices if console is missing.
C=/dev/console
[ -c "$C" ] || C=/dev/tty1

printf '\n   =*=*   INSTALLATION COMPLETE   =*=\n' > "$C"
printf '   The system has been installed and the disc is out.\n' > "$C"
printf '   Credentials:\n' > "$C"
printf '     host : X3MOS\n' > "$C"
printf '     login: root   (password: x3m@root)\n' > "$C"
printf '     login: x3m    (password: x3m@root)\n' > "$C"
printf '   Press ENTER to reboot into your new system...\n\n' > "$C"

# Wait for a key/line. The chosen device blocks until ENTER; the unit's
# TimeoutStartSec bounds the wait if nobody is at the console.
read -r _ < "$C" 2>/dev/null \
    || read -r _ < /dev/tty1 2>/dev/null \
    || read -r _ < /dev/ttyS0 2>/dev/null || true

sync
touch /var/lib/press-to-reboot.done
sync

printf 'Rebooting now...\n' > "$C"
systemctl reboot 2>/dev/null || reboot -f
exit 0