#!/bin/sh
# Boots into the freshly installed system, exactly once: prints the login
# credentials on the console, waits for ENTER (VGA or serial), then reboots
# so the machine starts clean at the login prompt on the next boot.
#
# Invoked by press-to-reboot.service just before getty.target, when the
# console and keyboard are fully initialized and nothing else owns the screen.

set -u

# Already done on a previous boot? Never show again.
[ -e /var/lib/press-to-reboot.done ] && exit 0

BANNER='\n   =*=*   INSTALLATION COMPLETE   =*=\n   The system has been installed and the disc is out.\n   Credentials:\n     host : X3MOS\n     login: root   (password: x3m@root)\n     login: x3m    (password: x3m@root)\n   Press ENTER to reboot into your new system...\n\n'

# StandardOutput=tty points stdout at /dev/console (the active VGA console).
printf '%b' "$BANNER"
# Mirror onto the serial line and VT1 for remote/other viewers.
for c in /dev/ttyS0 /dev/tty1; do
    [ -c "$c" ] || continue
    printf '%b' "$BANNER" > "$c" 2>/dev/null || true
done

# Wait for ENTER on the console (stdin is /dev/console too) or the serial
# line. Keypresses are buffered by the tty, so polling loses nothing. If no
# key arrives within ~300 s the boot just continues (matches TimeoutStartSec).
entered=
i=0
while [ "$i" -lt 300 ]; do
    if LC_ALL=C timeout 1 sh -c 'read -r _' 2>/dev/null; then
        entered=1
        break
    fi
    for c in /dev/ttyS0 /dev/tty1; do
        [ -c "$c" ] || continue
        if LC_ALL=C timeout 1 sh -c "read -r _ < '$c'" 2>/dev/null; then
            entered=1
            break 2
        fi
    done
    i=$((i + 1))
    sleep 1
done
[ -n "$entered" ] || exit 0

sync
touch /var/lib/press-to-reboot.done
sync

printf '\nRebooting now...\n'
for c in /dev/ttyS0 /dev/tty1; do
    [ -c "$c" ] || continue
    printf 'Rebooting now...\n' > "$c" 2>/dev/null || true
done
systemctl reboot 2>/dev/null || reboot -f
exit 0