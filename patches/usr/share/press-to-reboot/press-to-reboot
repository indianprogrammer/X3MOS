#!/bin/sh
# Runs once on the FIRST boot of the installed system, before the OS is
# fully brought up (invoked by press-to-reboot.service, ordered before
# sysinit.target). Shows a banner on the console, waits for ENTER, then
# reboots into the freshly installed system. VGA and serial consoles work.
#
# This is deterministic where an in-installer wait is not: at this point no
# other process (installer frontend, getty, etc.) owns the console, so the
# kernel delivers the keypress straight to this read.

set -u

# Already done on a previous boot? Never show again.
[ -e /var/lib/press-to-reboot.done ] && exit 0

# Mirror the banner onto every console (VGA tty1, serial ttyS0, and
# /dev/console whichever it maps to) so it is visible wherever the user is.
for c in /dev/console /dev/tty1 /dev/ttyS0; do
    [ -c "$c" ] || continue
    printf '\n   =*=*   INSTALLATION COMPLETE   =*=\n' > "$c" 2>/dev/null || true
    printf '   The system has been installed and the disc is out.\n' > "$c" 2>/dev/null || true
    printf '   Credentials:\n' > "$c" 2>/dev/null || true
    printf '     host : X3MOS\n' > "$c" 2>/dev/null || true
    printf '     login: root   (password: x3m@root)\n' > "$c" 2>/dev/null || true
    printf '     login: x3m    (password: x3m@root)\n' > "$c" 2>/dev/null || true
    printf '   Press ENTER to reboot into your new system...\n\n' > "$c" 2>/dev/null || true
done

# Wait for a key/line on either console. Keypresses are buffered by the tty,
# so polling with a short timeout loses nothing. The unit's TimeoutStartSec
# bounds the wait if nobody is at either console.
while :; do
    for c in /dev/tty1 /dev/ttyS0; do
        [ -c "$c" ] || continue
        if LC_ALL=C timeout 1 sh -c "read -r _ < '$c'" 2>/dev/null; then
            entered=1
            break 2
        fi
    done
    sleep 1
done
[ -n "$entered" ] || exit 1

sync
touch /var/lib/press-to-reboot.done
sync

for c in /dev/console /dev/tty1 /dev/ttyS0; do
    [ -c "$c" ] || continue
    printf 'Rebooting now...\n' > "$c" 2>/dev/null || true
done
systemctl reboot 2>/dev/null || reboot -f
exit 0